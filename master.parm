# =====================================================================
# master.parm  -  Swarm MASTER (leader), SYSID 1
# ArduCopter 4.5.x / 4.6.x  -  load AFTER frame setup, accel/compass/
# radio/ESC calibration, harmonic notch and AUTOTUNE are complete.
# Hardware: MicoAir743 (v1 or v2) stack, GEPRC GEP-M1025(Q) GPS on UART3,
# RadioMaster RP3 ELRS receiver on UART6, WiFi module on UART1 (SERIAL1).
# Load hardware_micoair743.parm FIRST (during the build), this file LAST.
# Names drift between releases: after loading, check the GCS report of
# unrecognised parameters (e.g. GPS_RATE_MS became GPS1_RATE_MS in 4.6,
# SYSID_MYGCS may appear as MAV_GCS_SYSID in newer firmware).
# Battery voltages assume a 6S LiPo - CHANGE THEM for your pack.
# Comments are on their own lines on purpose (some loaders reject
# inline comments).
# =====================================================================

# ---- Identity ----------------------------------------------------
SYSID_THISMAV,1
SYSID_MYGCS,255

# ---- Telemetry port + stream rates (Hz) --------------------------
# MicoAir743 UART1 = SERIAL1 (MAVLink2 by default) -> WiFi module
SERIAL1_PROTOCOL,2
# MUST match the WiFi module's UART baud (115 = 115200, 921 = 921600)
SERIAL1_BAUD,115
# GLOBAL_POSITION_INT = the swarm's reference signal
SR1_POSITION,10
# SYS_STATUS, GPS_RAW_INT
SR1_EXT_STAT,2
# ATTITUDE
SR1_EXTRA1,4
# VFR_HUD
SR1_EXTRA2,2
# EKF_STATUS_REPORT, battery, vibration
SR1_EXTRA3,2
SR1_RC_CHAN,1
SR1_RAW_SENS,0
SR1_RAW_CTRL,0
SR1_ADSB,0
SR1_PARAMS,10

# ---- GPS / EKF: GPS + baro only ------------------------------------
GPS_AUTO_CONFIG,1
# 5 Hz. The M10 (u-blox M10050) can't hold 10 Hz with 4 constellations.
GPS_RATE_MS,200
# stricter than default 140 -> won't arm on a mediocre fix
GPS_HDOP_GOOD,120
AHRS_EKF_TYPE,3
EK3_ENABLE,1
# 3 = GPS, 1 = baro, 1 = compass
EK3_SRC1_POSXY,3
EK3_SRC1_VELXY,3
EK3_SRC1_POSZ,1
EK3_SRC1_VELZ,3
EK3_SRC1_YAW,1
ARMING_CHECK,1

# ---- Failsafes common to all ------------------------------------
# RC loss -> RTL
FS_THR_ENABLE,1
FS_THR_VALUE,975
# EKF/GPS failure -> LAND (straight down = away from aircraft above)
FS_EKF_ACTION,1
FS_EKF_THRESH,0.8
FS_VIBE_ENABLE,1
FS_CRASH_CHECK,1
# battery: sag-compensated voltage, low -> RTL, critical -> LAND
BATT_FS_VOLTSRC,1
BATT_LOW_TIMER,10
BATT_LOW_VOLT,21.0
BATT_CRT_VOLT,19.8
BATT_FS_LOW_ACT,2
BATT_FS_CRT_ACT,1

# ---- RTL: straight up to own layer, straight home, land on own pad ----
# cone slope 0 = never lower RTL_ALT near home (keeps layers intact)
RTL_CONE_SLOPE,0
RTL_CLIMB_MIN,0
RTL_ALT_FINAL,0
RTL_LOIT_TIME,2000
LAND_SPEED,50

# ---- Geofence: max alt + circle + polygon ------------------------
FENCE_ENABLE,1
FENCE_TYPE,7
FENCE_MARGIN,3

# ---- Master-specific failsafes -----------------------------------
# Master is RC-flown and doesn't need the GCS link to fly safely.
# Set 1 (RTL) if you fly it purely from GCS waypoints with no pilot.
FS_GCS_ENABLE,0

# ---- Speed / accel: the master must be EASY TO FOLLOW -------------
# 5 m/s max, gentle accel/brake; slaves get 10 m/s and 4 m/s/s
LOIT_SPEED,500
LOIT_ACC_MAX,250
LOIT_BRK_ACCEL,150
LOIT_BRK_JERK,500
WPNAV_SPEED,500
WPNAV_ACCEL,150
WPNAV_SPEED_UP,150
WPNAV_SPEED_DN,100
PILOT_SPEED_UP,150
PILOT_SPEED_DN,100
ANGLE_MAX,2500

# ---- RTL: master returns BELOW the slave layers ------------------
# RTL_ALT is a minimum; 15 m means it comes home at its current
# altitude (8-25 m while engaged). The script lifts the slaves 5 m.
RTL_ALT,1500
RTL_SPEED,400

# ---- Fence -------------------------------------------------------
FENCE_ALT_MAX,30
# keep INSIDE your measured WiFi range minus the formation span (~30 m)
FENCE_RADIUS,80
# 4 = Brake (or Land); pilot then flies back inside
FENCE_ACTION,4

# ---- ELRS receiver (pilot's own TX, normal link mode, telemetry ON) ----
# RP3 on UART6 (RX6 AND TX6 - CRSF is two-wire). UART6 is already the
# board's RC input (SERIAL5 on MicoAir743 v1, SERIAL6 on v2): nothing to set.
# Do NOT set SERIAL2_PROTOCOL - UART2 is the HD VTX DisplayPort.
# 3 = RSSI / link quality from the CRSF stream
RSSI_TYPE,3

# ---- Switches ------------------------------------------------------
# ELRS treats AUX1 (ch5) as its ARM channel, so ch5 is the arm switch.
# 153 = arm/disarm switch (throttle must be low to arm)
RC5_OPTION,153
# ch6 3-pos flight mode switch -> positions 1/4/6
FLTMODE_CH,6
# low = LOITER, mid = ALT_HOLD (GPS-loss escape), high = AUTO (GCS waypoints)
FLTMODE1,5
FLTMODE2,5
FLTMODE3,2
FLTMODE4,2
FLTMODE5,3
FLTMODE6,3
# ch7 = RTL switch, ch8 = motor emergency stop
RC7_OPTION,4
RC8_OPTION,31
